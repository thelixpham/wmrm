# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs (~1 GB with torch -- never commit)
.venv/
venv/
env/

# Test fixtures are generated: `python tests/make_fixtures.py` rebuilds them,
# and the clips plus per-backend outputs run to tens of MB.
tests/fixtures/

# Tool output. Processed videos land next to their input as NAME-clean.EXT.
*-clean.mp4
*-clean.mov
*-clean.mkv
*-clean.webm

# Calibration previews and box checks, regenerated by `wmrm detect` /
# `wmrm run --preview-only`.
*-preview.png
*-preview-zoom.png
*-boxcheck.png
*-boxcheck-zoom.png
*-comparison.png

# Atomic-write temp files: run_inpaint writes .<stem>.<random>.mp4 then renames.
# A leftover only appears if a run was killed mid-write.
.*.mp4
.*.mov
.*.mkv

# Model weights live in ~/.cache/torch/hub/checkpoints/ and download on demand,
# but catch a stray copy placed here by hand (big-lama.pt is 196 MB).
*.pt
*.pth
*.ckpt

# Presets are deliberately NOT ignored -- wm-preset.json is the calibration
# result and is worth committing once it is confirmed against real footage.

.DS_Store
*.swp
